<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="JAASM.App.MainWindow" Title="Just Another ARK Server Manager" Width="1000" Height="780" MinWidth="800" MinHeight="650">
<ScrollViewer><StackPanel Margin="28" Spacing="14">
<TextBlock Text="JAASM" FontSize="34" FontWeight="Bold"/><TextBlock Text="Just Another ARK Server Manager" Opacity="0.65"/>
<TextBlock Text="Phase 1 — SteamCMD Bootstrap" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,0"/><TextBlock x:Name="PlatformText"/>
<TextBlock Text="Use Existing SteamCMD" FontSize="18" FontWeight="SemiBold"/><TextBox x:Name="SteamCmdPathBox" IsReadOnly="True" Watermark="SteamCMD is not configured"/>
<StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Select Existing Directory" Click="SelectSteamCmd_Click"/><Button Content="Validate" Click="ValidateSteamCmd_Click"/></StackPanel>
<Separator Margin="0,8"/><TextBlock Text="Install New SteamCMD" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="SteamCMD will be installed directly into the directory selected below." Opacity="0.65"/>
<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBox x:Name="SteamCmdInstallDirectoryBox" IsReadOnly="True" Watermark="Select an installation directory"/><Button Grid.Column="1" Content="Browse" Click="BrowseSteamCmdInstallDirectory_Click"/></Grid>
<Button Content="Download &amp; Install SteamCMD" HorizontalAlignment="Left" Click="InstallSteamCmd_Click"/><ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Height="8"/><TextBlock x:Name="StatusText" Text="Ready." TextWrapping="Wrap"/>
<TextBlock Text="Console" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
<Grid RowDefinitions="*,Auto" MinHeight="230"><TextBox x:Name="ConsoleBox" Grid.Row="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, monospace" VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/><Button Grid.Row="1" Content="Clear Console" HorizontalAlignment="Right" Margin="0,8,0,0" Click="ClearConsole_Click"/></Grid>
<Separator Margin="0,10"/><TextBlock Text="Optional Web GUI" FontSize="18" FontWeight="SemiBold"/><ToggleSwitch x:Name="WebGuiToggle" Content="Enable Web GUI" IsCheckedChanged="WebGuiToggle_Changed"/><TextBlock Text="Phase 1 stores this setting only. The web host will be implemented in a later phase." Opacity="0.65"/><TextBlock Text="Default bind: 127.0.0.1:8484" Opacity="0.65"/>
</StackPanel></ScrollViewer></Window>