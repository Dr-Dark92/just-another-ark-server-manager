<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:JAASM.App.Models"
 x:Class="JAASM.App.MainWindow" Title="Just Another ARK Server Manager" Width="1080" Height="900" MinWidth="860" MinHeight="720">
<Grid RowDefinitions="Auto,*" Margin="28">
<StackPanel Grid.Row="0" Margin="0,0,0,18"><TextBlock Text="JAASM" FontSize="34" FontWeight="Bold"/><TextBlock Text="Just Another ARK Server Manager" Opacity="0.65"/></StackPanel>
<TabControl Grid.Row="1">
<TabItem Header="Server Setup"><ScrollViewer><StackPanel Margin="18" Spacing="14">
<TextBlock Text="SteamCMD Bootstrap" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="PlatformText"/>
<TextBlock Text="Use Existing SteamCMD" FontSize="18" FontWeight="SemiBold"/><TextBox x:Name="SteamCmdPathBox" IsReadOnly="True" PlaceholderText="SteamCMD is not configured"/>
<StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Select Existing Directory" Click="SelectSteamCmd_Click"/><Button Content="Validate" Click="ValidateSteamCmd_Click"/><Button Content="Update SteamCMD" Click="UpdateSteamCmd_Click"/></StackPanel>
<Separator/><TextBlock Text="Install New SteamCMD" FontSize="18" FontWeight="SemiBold"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBox x:Name="SteamCmdInstallDirectoryBox" IsReadOnly="True" PlaceholderText="Select an installation directory"/><Button Grid.Column="1" Content="Browse" Click="BrowseSteamCmdInstallDirectory_Click"/></Grid>
<Button Content="Download &amp; Install SteamCMD" HorizontalAlignment="Left" Click="InstallSteamCmd_Click"/><ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Height="8"/><TextBlock x:Name="StatusText" Text="Ready." TextWrapping="Wrap"/>
<Separator/><TextBlock Text="ARK: Survival Ascended Server Bootstrap" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="ASA Dedicated Server App ID: 2430930" Opacity="0.65"/>
<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBox x:Name="AsaInstallDirectoryBox" IsReadOnly="True" PlaceholderText="Select ASA server installation directory"/><Button Grid.Column="1" Content="Browse" Click="BrowseAsaInstallDirectory_Click"/></Grid>
<StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Install / Update ASA" Click="InstallOrUpdateAsa_Click"/><Button Content="Validate ASA" Click="ValidateAsa_Click"/></StackPanel><TextBlock x:Name="AsaStatusText" Text="ASA server is not configured." TextWrapping="Wrap"/>
<Separator/><TextBlock Text="Optional Web GUI" FontSize="18" FontWeight="SemiBold"/><ToggleSwitch x:Name="WebGuiToggle" Content="Enable Web GUI" IsCheckedChanged="WebGuiToggle_Changed"/><TextBlock Text="Default bind: 127.0.0.1:8484" Opacity="0.65"/>
</StackPanel></ScrollViewer></TabItem>

<TabItem Header="Server Control">
<ScrollViewer>
<StackPanel Margin="18" Spacing="12">

<TextBlock Text="ARK Server Profiles" FontSize="22" FontWeight="SemiBold"/>
<TextBlock Text="Each tab is an independent ASA server profile. Use Add New Server + to create another server." Opacity="0.65" TextWrapping="Wrap"/>

<Border BorderBrush="#444" BorderThickness="0,0,0,1" Padding="0,0,0,4">
  <WrapPanel x:Name="ProfileTabStrip" Orientation="Horizontal">
    <Button Content="Add New Server +"
            Margin="4,0,0,0"
            Padding="14,8"
            Click="CreateProfile_Click"/>
  </WrapPanel>
</Border>

<Border x:Name="ProfileOverviewPanel"
        IsVisible="False"
        BorderBrush="#4a4a4a"
        BorderThickness="1"
        CornerRadius="8"
        Padding="14"
        Margin="0,8,0,0">
  <Grid ColumnDefinitions="2*,*,*,*" ColumnSpacing="18">
    <StackPanel>
      <TextBlock Text="Active Server" FontSize="11" Opacity="0.55"/>
      <TextBlock x:Name="ActiveProfileNameText" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="ActiveProfileMapText" Opacity="0.7"/>
    </StackPanel>
    <StackPanel Grid.Column="1">
      <TextBlock Text="Status" FontSize="11" Opacity="0.55"/>
      <TextBlock x:Name="ActiveProfileStateText" Text="Stopped" FontWeight="SemiBold"/>
    </StackPanel>
    <StackPanel Grid.Column="2">
      <TextBlock Text="Ports" FontSize="11" Opacity="0.55"/>
      <TextBlock x:Name="ActiveProfilePortsText"/>
    </StackPanel>
    <StackPanel Grid.Column="3">
      <TextBlock Text="Mods" FontSize="11" Opacity="0.55"/>
      <TextBlock x:Name="ActiveProfileModsText" Text="0 enabled"/>
    </StackPanel>
  </Grid>
</Border>

<Border x:Name="NoProfilePanel"
        BorderBrush="#444"
        BorderThickness="1"
        CornerRadius="6"
        Padding="24"
        Margin="0,8,0,0">
  <StackPanel Spacing="8">
    <TextBlock Text="No ARK server profiles" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Text="Click Add New Server + above to create your first server profile." Opacity="0.65"/>
  </StackPanel>
</Border>

<StackPanel x:Name="ProfileEditorPanel" Spacing="12" IsVisible="False">
<TextBlock x:Name="ProfileExplanationText" Text="This profile runs independently. Its game, query and RCON ports must not conflict with another running profile." Opacity="0.7" TextWrapping="Wrap"/>
<TextBlock Text="Profile Configuration" FontSize="18" FontWeight="SemiBold"/>
<TextBlock Text="Every field below belongs only to the selected server profile." Opacity="0.6"/>
<Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
<StackPanel Grid.Row="0"><TextBlock Text="Server Name"/><TextBlock Text="Public session name shown in the ARK server browser." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel><TextBox x:Name="ServerNameBox" Grid.Row="0" Grid.Column="1"/>
<StackPanel Grid.Row="1"><TextBlock Text="Map"/><TextBlock Text="World loaded by this server profile. Each profile may run a different map." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
<ComboBox x:Name="MapBox" Grid.Row="1" Grid.Column="1" SelectedIndex="0">
<ComboBoxItem Content="The Island" Tag="TheIsland_WP"/>
<ComboBoxItem Content="Scorched Earth" Tag="ScorchedEarth_WP"/>
<ComboBoxItem Content="The Center" Tag="TheCenter_WP"/>
<ComboBoxItem Content="Aberration" Tag="Aberration_WP"/>
<ComboBoxItem Content="Extinction" Tag="Extinction_WP"/>
<ComboBoxItem Content="Ragnarok" Tag="Ragnarok_WP"/>
<ComboBoxItem Content="Valguero" Tag="Valguero_WP"/>
<ComboBoxItem Content="Astraeos" Tag="Astraeos_WP"/>
<ComboBoxItem Content="Genesis Ascended Part 1" Tag="Genesis_WP"/>
<ComboBoxItem Content="Lost Colony" Tag="LostColony_WP"/>
</ComboBox>
<StackPanel Grid.Row="2"><TextBlock Text="Max Players"/><TextBlock Text="Maximum simultaneous player connections allowed." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel><NumericUpDown x:Name="MaxPlayersBox" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="500"/>
<StackPanel Grid.Row="3"><TextBlock Text="Game Port"/><TextBlock Text="Primary UDP gameplay port. Must be unique per profile." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel><NumericUpDown x:Name="GamePortBox" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="65535"/>
<StackPanel Grid.Row="4"><TextBlock Text="Query Port"/><TextBlock Text="Steam/server-browser query port. Must be unique per profile." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel><NumericUpDown x:Name="QueryPortBox" Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="65535"/>
<StackPanel Grid.Row="5"><TextBlock Text="RCON Port"/><TextBlock Text="Remote administration port. JAASM will later use this for graceful save/shutdown and commands." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel><NumericUpDown x:Name="RconPortBox" Grid.Row="5" Grid.Column="1" Minimum="1" Maximum="65535"/>
<StackPanel Grid.Row="6"><TextBlock Text="Server Password"/><TextBlock Text="Optional password players must enter to join this server." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel><TextBox x:Name="ServerPasswordBox" Grid.Row="6" Grid.Column="1" PasswordChar="●"/>
<StackPanel Grid.Row="7"><TextBlock Text="Admin Password"/><TextBlock Text="Administrative password used for privileged server/RCON operations." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel><TextBox x:Name="AdminPasswordBox" Grid.Row="7" Grid.Column="1" PasswordChar="●"/>
<StackPanel Grid.Row="8"><TextBlock Text="Extra Arguments"/><TextBlock Text="Optional advanced startup switches. Use Choose Arguments for descriptions instead of typing flags manually." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
<StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Spacing="10">
<Button Content="Choose Arguments..." Click="ChooseExtraArguments_Click"/>
<TextBlock x:Name="ExtraArgumentsSummaryText" Text="None selected" VerticalAlignment="Center" Opacity="0.7"/>
</StackPanel>
</Grid>
<Separator/>
<TextBlock Text="Server Customization" FontSize="22" FontWeight="SemiBold"/>
<TextBlock Text="JAASM generates GameUserSettings.ini from these controls. Each option shows what it changes and the underlying ARK configuration key." Opacity="0.7" TextWrapping="Wrap"/>

<TabControl>
  <TabItem Header="General">
    <ScrollViewer>
      <StackPanel Margin="12" Spacing="12">
        <Grid ColumnDefinitions="320,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">
          <StackPanel Grid.Row="0"><TextBlock Text="Server Mode"/><TextBlock Text="PvE disables normal player-vs-player combat. Config: ServerPVE. Default: PvE." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <ComboBox x:Name="PveModeBox" Grid.Row="0" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="PvE" Tag="true"/><ComboBoxItem Content="PvP" Tag="false"/></ComboBox>

          <StackPanel Grid.Row="1"><TextBlock Text="Allow Third Person"/><TextBlock Text="Allows players to use third-person camera. Config: AllowThirdPersonPlayer. Default: enabled." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <ToggleSwitch x:Name="AllowThirdPersonToggle" Grid.Row="1" Grid.Column="1"/>

          <StackPanel Grid.Row="2"><TextBlock Text="Show Player on Map"/><TextBlock Text="Displays the player's own position on the map. Config: ShowMapPlayerLocation. Default: enabled." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <ToggleSwitch x:Name="ShowMapPlayerLocationToggle" Grid.Row="2" Grid.Column="1"/>

          <StackPanel Grid.Row="3"><TextBlock Text="Server Crosshair"/><TextBlock Text="Enables the aiming crosshair. Config: ServerCrosshair. Default: enabled." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <ToggleSwitch x:Name="ServerCrosshairToggle" Grid.Row="3" Grid.Column="1"/>

          <StackPanel Grid.Row="4"><TextBlock Text="Hit Markers"/><TextBlock Text="Shows hit confirmation markers. Config: AllowHitMarkers. Default: enabled." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <ToggleSwitch x:Name="AllowHitMarkersToggle" Grid.Row="4" Grid.Column="1"/>

          <StackPanel Grid.Row="5"><TextBlock Text="Disable PvE Structure Decay"/><TextBlock Text="Stops automatic structure decay on PvE servers. Config: DisableStructureDecayPvE. Default: disabled." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <ToggleSwitch x:Name="DisableStructureDecayPveToggle" Grid.Row="5" Grid.Column="1"/>

          <StackPanel Grid.Row="6"><TextBlock Text="Disable PvE Dino Decay"/><TextBlock Text="Stops automatic tame decay on PvE servers. Config: DisableDinoDecayPvE. Default: disabled." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <ToggleSwitch x:Name="DisableDinoDecayPveToggle" Grid.Row="6" Grid.Column="1"/>

          <StackPanel Grid.Row="7"><TextBlock Text="Offline Raid Protection"/><TextBlock Text="Enables ARK's offline PvP protection behavior. Config: PreventOfflinePvP. Default: disabled." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <ToggleSwitch x:Name="PreventOfflinePvpToggle" Grid.Row="7" Grid.Column="1"/>

          <StackPanel Grid.Row="8"><TextBlock Text="Difficulty Offset"/><TextBlock Text="Base difficulty scaling. Config: DifficultyOffset. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <NumericUpDown x:Name="DifficultyOffsetBox" Grid.Row="8" Grid.Column="1" Minimum="0" Maximum="10" Increment="0.1" FormatString="0.0"/>

          <StackPanel Grid.Row="9"><TextBlock Text="Override Official Difficulty"/><TextBlock Text="Controls maximum wild creature level scaling; 5.0 commonly yields level 150. Config: OverrideOfficialDifficulty. Default: 5.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <NumericUpDown x:Name="OverrideOfficialDifficultyBox" Grid.Row="9" Grid.Column="1" Minimum="0.1" Maximum="100" Increment="0.5" FormatString="0.0"/>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </TabItem>

  <TabItem Header="Rates">
    <ScrollViewer>
      <StackPanel Margin="12" Spacing="12">
        <Grid ColumnDefinitions="320,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">
          <StackPanel Grid.Row="0"><TextBlock Text="XP Multiplier"/><TextBlock Text="Global experience gain rate. 3.0 means roughly 3× XP. Config: XPMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <NumericUpDown x:Name="XpMultiplierBox" Grid.Row="0" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.25" FormatString="0.00"/>

          <StackPanel Grid.Row="1"><TextBlock Text="Taming Speed"/><TextBlock Text="How quickly creatures tame. Higher values reduce taming time. Config: TamingSpeedMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <NumericUpDown x:Name="TamingSpeedBox" Grid.Row="1" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.25" FormatString="0.00"/>

          <StackPanel Grid.Row="2"><TextBlock Text="Harvest Amount"/><TextBlock Text="Amount of resources received per harvest. Config: HarvestAmountMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <NumericUpDown x:Name="HarvestAmountBox" Grid.Row="2" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.25" FormatString="0.00"/>

          <StackPanel Grid.Row="3"><TextBlock Text="Harvest Health"/><TextBlock Text="Resource-node health before depletion; higher values generally allow more harvesting hits. Config: HarvestHealthMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <NumericUpDown x:Name="HarvestHealthBox" Grid.Row="3" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.25" FormatString="0.00"/>

          <StackPanel Grid.Row="4"><TextBlock Text="Player Food Drain"/><TextBlock Text="Player hunger drain rate. Lower values make food drain more slowly. Config: PlayerCharacterFoodDrainMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <NumericUpDown x:Name="PlayerFoodDrainBox" Grid.Row="4" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.1" FormatString="0.00"/>

          <StackPanel Grid.Row="5"><TextBlock Text="Player Water Drain"/><TextBlock Text="Player thirst drain rate. Lower values make water drain more slowly. Config: PlayerCharacterWaterDrainMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <NumericUpDown x:Name="PlayerWaterDrainBox" Grid.Row="5" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.1" FormatString="0.00"/>

          <StackPanel Grid.Row="6"><TextBlock Text="Dino Food Drain"/><TextBlock Text="Creature food drain rate. Affects hunger and can influence taming behavior. Config: DinoCharacterFoodDrainMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <NumericUpDown x:Name="DinoFoodDrainBox" Grid.Row="6" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.1" FormatString="0.00"/>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </TabItem>

  <TabItem Header="World">
    <ScrollViewer>
      <StackPanel Margin="12" Spacing="12">
        <Grid ColumnDefinitions="320,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">
          <StackPanel Grid.Row="0"><TextBlock Text="Day Cycle Speed"/><TextBlock Text="Overall day/night cycle speed. Lower values make a full cycle longer. Config: DayCycleSpeedScale. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <NumericUpDown x:Name="DayCycleSpeedBox" Grid.Row="0" Grid.Column="1" Minimum="0.01" Maximum="100" Increment="0.1" FormatString="0.00"/>

          <StackPanel Grid.Row="1"><TextBlock Text="Day Time Speed"/><TextBlock Text="Daytime passage speed. Lower values make daytime last longer. Config: DayTimeSpeedScale. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <NumericUpDown x:Name="DayTimeSpeedBox" Grid.Row="1" Grid.Column="1" Minimum="0.01" Maximum="100" Increment="0.1" FormatString="0.00"/>

          <StackPanel Grid.Row="2"><TextBlock Text="Night Time Speed"/><TextBlock Text="Nighttime passage speed. Higher values make nights pass faster. Config: NightTimeSpeedScale. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <NumericUpDown x:Name="NightTimeSpeedBox" Grid.Row="2" Grid.Column="1" Minimum="0.01" Maximum="100" Increment="0.1" FormatString="0.00"/>

          <StackPanel Grid.Row="3"><TextBlock Text="Wild Dino Count"/><TextBlock Text="Global wild creature population multiplier. Config: DinoCountMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <NumericUpDown x:Name="DinoCountBox" Grid.Row="3" Grid.Column="1" Minimum="0.01" Maximum="20" Increment="0.1" FormatString="0.00"/>

          <StackPanel Grid.Row="4"><TextBlock Text="Resource Respawn Period"/><TextBlock Text="Time before harvested resources respawn. Lower values respawn resources faster. Config: ResourcesRespawnPeriodMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <NumericUpDown x:Name="ResourceRespawnBox" Grid.Row="4" Grid.Column="1" Minimum="0.01" Maximum="100" Increment="0.1" FormatString="0.00"/>

          <StackPanel Grid.Row="5"><TextBlock Text="Spoiling Time"/><TextBlock Text="Multiplier applied to item spoil timers. Higher values make perishables last longer. Config: GlobalSpoilingTimeMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <NumericUpDown x:Name="SpoilingTimeBox" Grid.Row="5" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.25" FormatString="0.00"/>

          <StackPanel Grid.Row="6"><TextBlock Text="Dropped Item Decomposition"/><TextBlock Text="How long dropped items remain before disappearing. Config: GlobalItemDecompositionTimeMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <NumericUpDown x:Name="ItemDecompositionBox" Grid.Row="6" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.25" FormatString="0.00"/>

          <StackPanel Grid.Row="7"><TextBlock Text="Corpse Decomposition"/><TextBlock Text="How long corpses remain before disappearing. Config: GlobalCorpseDecompositionTimeMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
          <NumericUpDown x:Name="CorpseDecompositionBox" Grid.Row="7" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.25" FormatString="0.00"/>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </TabItem>

  <TabItem Header="Breeding">
    <ScrollViewer><StackPanel Margin="12" Spacing="12">
      <Grid ColumnDefinitions="320,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">
        <StackPanel Grid.Row="0"><TextBlock Text="Mating Interval"/><TextBlock Text="Time between mating attempts. Lower values allow breeding sooner. Config: MatingIntervalMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
        <NumericUpDown x:Name="MatingIntervalBox" Grid.Row="0" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
        <StackPanel Grid.Row="1"><TextBlock Text="Egg Hatch Speed"/><TextBlock Text="Egg incubation and gestation speed. Higher values hatch/birth faster. Config: EggHatchSpeedMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
        <NumericUpDown x:Name="EggHatchSpeedBox" Grid.Row="1" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.25" FormatString="0.00"/>
        <StackPanel Grid.Row="2"><TextBlock Text="Baby Mature Speed"/><TextBlock Text="How quickly babies mature. Higher values shorten maturation. Config: BabyMatureSpeedMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
        <NumericUpDown x:Name="BabyMatureSpeedBox" Grid.Row="2" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.25" FormatString="0.00"/>
        <StackPanel Grid.Row="3"><TextBlock Text="Cuddle Interval"/><TextBlock Text="Time between imprint requests. Lower values make requests more frequent. Config: BabyCuddleIntervalMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
        <NumericUpDown x:Name="BabyCuddleIntervalBox" Grid.Row="3" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
        <StackPanel Grid.Row="4"><TextBlock Text="Imprint Amount"/><TextBlock Text="Imprint percentage awarded per successful care interaction. Config: BabyImprintAmountMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
        <NumericUpDown x:Name="BabyImprintAmountBox" Grid.Row="4" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.25" FormatString="0.00"/>
        <StackPanel Grid.Row="5"><TextBlock Text="Baby Food Consumption"/><TextBlock Text="Baby food drain rate. Lower values reduce food consumption. Config: BabyFoodConsumptionSpeedMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
        <NumericUpDown x:Name="BabyFoodConsumptionBox" Grid.Row="5" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.1" FormatString="0.00"/>
      </Grid>
    </StackPanel></ScrollViewer>
  </TabItem>

  <TabItem Header="Structures">
    <ScrollViewer><StackPanel Margin="12" Spacing="12">
      <Grid ColumnDefinitions="320,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">
        <StackPanel Grid.Row="0"><TextBlock Text="Structure Resistance"/><TextBlock Text="Damage received by structures. Lower values make structures tougher. Config: StructureResistanceMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
        <NumericUpDown x:Name="StructureResistanceBox" Grid.Row="0" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.1" FormatString="0.00"/>
        <StackPanel Grid.Row="1"><TextBlock Text="Structure Damage"/><TextBlock Text="Global damage dealt by structures such as turrets. Config: StructureDamageMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
        <NumericUpDown x:Name="StructureDamageBox" Grid.Row="1" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.1" FormatString="0.00"/>
        <StackPanel Grid.Row="2"><TextBlock Text="PvE Structure Decay Period"/><TextBlock Text="Scales PvE structure decay timing. Config: PvEStructureDecayPeriodMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
        <NumericUpDown x:Name="PveStructureDecayPeriodBox" Grid.Row="2" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.1" FormatString="0.00"/>
        <StackPanel Grid.Row="3"><TextBlock Text="PvE Dino Decay Period"/><TextBlock Text="Scales PvE tame decay timing. Config: PvEDinoDecayPeriodMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
        <NumericUpDown x:Name="PveDinoDecayPeriodBox" Grid.Row="3" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.1" FormatString="0.00"/>
        <StackPanel Grid.Row="4"><TextBlock Text="Allow Cave Building PvE"/><TextBlock Text="Permits PvE structure placement in cave areas where normally restricted. Config: AllowCaveBuildingPvE." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
        <ToggleSwitch x:Name="AllowCaveBuildingPveToggle" Grid.Row="4" Grid.Column="1"/>
        <StackPanel Grid.Row="5"><TextBlock Text="Extra Structure Prevention Volumes"/><TextBlock Text="Keeps additional map-specific no-build volumes enabled. Config: EnableExtraStructurePreventionVolumes. Default: enabled." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
        <ToggleSwitch x:Name="ExtraStructurePreventionToggle" Grid.Row="5" Grid.Column="1"/>
        <StackPanel Grid.Row="6"><TextBlock Text="PvP Structure Decay"/><TextBlock Text="Allows abandoned structures to decay on PvP servers. Config: PvPStructureDecay. Default: enabled." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
        <ToggleSwitch x:Name="PvpStructureDecayToggle" Grid.Row="6" Grid.Column="1"/>
      </Grid>
    </StackPanel></ScrollViewer>
  </TabItem>

  <TabItem Header="Player &amp; Dinos">
    <ScrollViewer><StackPanel Margin="12" Spacing="12">
      <Grid ColumnDefinitions="320,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">
        <StackPanel Grid.Row="0"><TextBlock Text="Player Damage"/><TextBlock Text="Global player damage multiplier. Config: PlayerDamageMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel><NumericUpDown x:Name="PlayerDamageBox" Grid.Row="0" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.1" FormatString="0.00"/>
        <StackPanel Grid.Row="1"><TextBlock Text="Player Resistance"/><TextBlock Text="Damage received by players. Lower values make players tougher. Config: PlayerResistanceMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel><NumericUpDown x:Name="PlayerResistanceBox" Grid.Row="1" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.1" FormatString="0.00"/>
        <StackPanel Grid.Row="2"><TextBlock Text="Dino Damage"/><TextBlock Text="Global creature damage multiplier. Config: DinoDamageMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel><NumericUpDown x:Name="DinoDamageBox" Grid.Row="2" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.1" FormatString="0.00"/>
        <StackPanel Grid.Row="3"><TextBlock Text="Dino Resistance"/><TextBlock Text="Damage received by creatures. Lower values make creatures tougher. Config: DinoResistanceMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel><NumericUpDown x:Name="DinoResistanceBox" Grid.Row="3" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.1" FormatString="0.00"/>
        <StackPanel Grid.Row="4"><TextBlock Text="Player Stamina Drain"/><TextBlock Text="Player stamina consumption rate. Lower values drain stamina more slowly. Config: PlayerStaminaDrainMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel><NumericUpDown x:Name="PlayerStaminaDrainBox" Grid.Row="4" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.1" FormatString="0.00"/>
        <StackPanel Grid.Row="5"><TextBlock Text="Dino Stamina Drain"/><TextBlock Text="Creature stamina consumption rate. Config: DinoStaminaDrainMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel><NumericUpDown x:Name="DinoStaminaDrainBox" Grid.Row="5" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.1" FormatString="0.00"/>
        <StackPanel Grid.Row="6"><TextBlock Text="Player Health Recovery"/><TextBlock Text="Player health regeneration rate. Config: PlayerHealthRecoveryMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel><NumericUpDown x:Name="PlayerHealthRecoveryBox" Grid.Row="6" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.1" FormatString="0.00"/>
        <StackPanel Grid.Row="7"><TextBlock Text="Dino Health Recovery"/><TextBlock Text="Creature health regeneration rate. Config: DinoHealthRecoveryMultiplier. Default: 1.0." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/></StackPanel><NumericUpDown x:Name="DinoHealthRecoveryBox" Grid.Row="7" Grid.Column="1" Minimum="0.01" Maximum="1000" Increment="0.1" FormatString="0.00"/>
      </Grid>
    </StackPanel></ScrollViewer>
  </TabItem>

  <TabItem Header="Per-Level Stats">
    <StackPanel Margin="12" Spacing="10">
      <TextBlock Text="Per-Level Stat Multipliers" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="These values are stored per server profile and written directly to Game.ini. Dino tabs intentionally exclude player-only Fortitude and Crafting Skill." TextWrapping="Wrap" Opacity="0.7"/>
      <TextBlock x:Name="PerLevelStatsSummaryText" Text="All multipliers at default 1.0" Opacity="0.65"/>
      <TabControl><TabItem Header="Player"><ScrollViewer><StackPanel Margin="12" Spacing="10"><TextBlock Text="Player per-level multipliers. Default: 1.0." Opacity="0.65"/><Grid ColumnDefinitions="280,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8"><TextBlock Grid.Row="0" Text="Health [0]" VerticalAlignment="Center"/><NumericUpDown x:Name="PlayerStat0Box" Grid.Row="0" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="1" Text="Stamina [1]" VerticalAlignment="Center"/><NumericUpDown x:Name="PlayerStat1Box" Grid.Row="1" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="2" Text="Torpidity [2]" VerticalAlignment="Center"/><NumericUpDown x:Name="PlayerStat2Box" Grid.Row="2" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="3" Text="Oxygen [3]" VerticalAlignment="Center"/><NumericUpDown x:Name="PlayerStat3Box" Grid.Row="3" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="4" Text="Food [4]" VerticalAlignment="Center"/><NumericUpDown x:Name="PlayerStat4Box" Grid.Row="4" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="5" Text="Water [5]" VerticalAlignment="Center"/><NumericUpDown x:Name="PlayerStat5Box" Grid.Row="5" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="6" Text="Temperature [6]" VerticalAlignment="Center"/><NumericUpDown x:Name="PlayerStat6Box" Grid.Row="6" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="7" Text="Weight [7]" VerticalAlignment="Center"/><NumericUpDown x:Name="PlayerStat7Box" Grid.Row="7" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="8" Text="Melee Damage [8]" VerticalAlignment="Center"/><NumericUpDown x:Name="PlayerStat8Box" Grid.Row="8" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="9" Text="Movement Speed [9]" VerticalAlignment="Center"/><NumericUpDown x:Name="PlayerStat9Box" Grid.Row="9" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="10" Text="Fortitude [10]" VerticalAlignment="Center"/><NumericUpDown x:Name="PlayerStat10Box" Grid.Row="10" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="11" Text="Crafting Skill [11]" VerticalAlignment="Center"/><NumericUpDown x:Name="PlayerStat11Box" Grid.Row="11" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/></Grid></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Wild Dino"><ScrollViewer><StackPanel Margin="12" Spacing="10"><TextBlock Text="Wild Dino per-level multipliers. Default: 1.0." Opacity="0.65"/><Grid ColumnDefinitions="280,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8"><TextBlock Grid.Row="0" Text="Health [0]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoWildStat0Box" Grid.Row="0" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="1" Text="Stamina [1]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoWildStat1Box" Grid.Row="1" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="2" Text="Torpidity [2]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoWildStat2Box" Grid.Row="2" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="3" Text="Oxygen [3]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoWildStat3Box" Grid.Row="3" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="4" Text="Food [4]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoWildStat4Box" Grid.Row="4" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="5" Text="Water [5]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoWildStat5Box" Grid.Row="5" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="6" Text="Temperature [6]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoWildStat6Box" Grid.Row="6" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="7" Text="Weight [7]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoWildStat7Box" Grid.Row="7" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="8" Text="Melee Damage [8]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoWildStat8Box" Grid.Row="8" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="9" Text="Movement Speed [9]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoWildStat9Box" Grid.Row="9" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/></Grid></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Tamed Level-Up"><ScrollViewer><StackPanel Margin="12" Spacing="10"><TextBlock Text="Tamed Level-Up per-level multipliers. Default: 1.0." Opacity="0.65"/><Grid ColumnDefinitions="280,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8"><TextBlock Grid.Row="0" Text="Health [0]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedStat0Box" Grid.Row="0" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="1" Text="Stamina [1]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedStat1Box" Grid.Row="1" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="2" Text="Torpidity [2]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedStat2Box" Grid.Row="2" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="3" Text="Oxygen [3]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedStat3Box" Grid.Row="3" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="4" Text="Food [4]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedStat4Box" Grid.Row="4" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="5" Text="Water [5]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedStat5Box" Grid.Row="5" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="6" Text="Temperature [6]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedStat6Box" Grid.Row="6" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="7" Text="Weight [7]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedStat7Box" Grid.Row="7" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="8" Text="Melee Damage [8]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedStat8Box" Grid.Row="8" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="9" Text="Movement Speed [9]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedStat9Box" Grid.Row="9" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/></Grid></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Tamed Additive"><ScrollViewer><StackPanel Margin="12" Spacing="10"><TextBlock Text="Tamed Additive per-level multipliers. Default: 1.0." Opacity="0.65"/><Grid ColumnDefinitions="280,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8"><TextBlock Grid.Row="0" Text="Health [0]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAddStat0Box" Grid.Row="0" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="1" Text="Stamina [1]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAddStat1Box" Grid.Row="1" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="2" Text="Torpidity [2]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAddStat2Box" Grid.Row="2" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="3" Text="Oxygen [3]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAddStat3Box" Grid.Row="3" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="4" Text="Food [4]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAddStat4Box" Grid.Row="4" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="5" Text="Water [5]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAddStat5Box" Grid.Row="5" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="6" Text="Temperature [6]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAddStat6Box" Grid.Row="6" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="7" Text="Weight [7]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAddStat7Box" Grid.Row="7" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="8" Text="Melee Damage [8]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAddStat8Box" Grid.Row="8" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="9" Text="Movement Speed [9]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAddStat9Box" Grid.Row="9" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/></Grid></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Tamed Affinity"><ScrollViewer><StackPanel Margin="12" Spacing="10"><TextBlock Text="Tamed Affinity per-level multipliers. Default: 1.0." Opacity="0.65"/><Grid ColumnDefinitions="280,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8"><TextBlock Grid.Row="0" Text="Health [0]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAffinityStat0Box" Grid.Row="0" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="1" Text="Stamina [1]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAffinityStat1Box" Grid.Row="1" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="2" Text="Torpidity [2]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAffinityStat2Box" Grid.Row="2" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="3" Text="Oxygen [3]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAffinityStat3Box" Grid.Row="3" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="4" Text="Food [4]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAffinityStat4Box" Grid.Row="4" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="5" Text="Water [5]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAffinityStat5Box" Grid.Row="5" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="6" Text="Temperature [6]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAffinityStat6Box" Grid.Row="6" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="7" Text="Weight [7]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAffinityStat7Box" Grid.Row="7" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="8" Text="Melee Damage [8]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAffinityStat8Box" Grid.Row="8" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/>
<TextBlock Grid.Row="9" Text="Movement Speed [9]" VerticalAlignment="Center"/><NumericUpDown x:Name="DinoTamedAffinityStat9Box" Grid.Row="9" Grid.Column="1" Minimum="0.001" Maximum="1000" Increment="0.1" FormatString="0.000"/></Grid></StackPanel></ScrollViewer></TabItem></TabControl>
      <Button Content="Reset Per-Level Stats to 1.0" HorizontalAlignment="Left" Click="ResetPerLevelStats_Click"/>
    </StackPanel>
  </TabItem>


  <TabItem Header="Mods">
    <StackPanel Margin="12" Spacing="10">
      <TextBlock Text="ASA Mod Manager" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Manage the selected server's load order, discover CurseForge mods, and review update metadata without making the server dependent on the metadata provider." TextWrapping="Wrap" Opacity="0.7"/>

      <TabControl>
        <TabItem Header="Installed Mods">
          <Grid Margin="10" RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,180,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
              <TextBlock Text="Mod ID" VerticalAlignment="Center"/>
              <TextBox x:Name="NewModIdBox" Grid.Column="1" PlaceholderText="e.g. 933029"/>
              <Button Grid.Column="2" Content="Add by ID" Click="AddMod_Click"/>
              <Button Grid.Column="3" Content="Remove" Click="RemoveMod_Click"/>
              <Button Grid.Column="4" Content="Move Up" Click="MoveModUp_Click"/>
              <Button Grid.Column="5" Content="Move Down" Click="MoveModDown_Click"/>
              <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8">
                <Button Content="Enable / Disable" Click="ToggleModEnabled_Click"/>
                <Button Content="Refresh Metadata" Click="RefreshSelectedModMetadata_Click"/>
              </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="380,*" ColumnSpacing="12">
              <ListBox x:Name="ModsListBox" SelectionChanged="ModsListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:AsaModEntry">
                    <Border BorderBrush="#444" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{Binding LoadOrder}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding ModId}" FontSize="11" Opacity="0.65"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" IsEnabled="False" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Border Grid.Column="1" BorderBrush="#444" BorderThickness="1" CornerRadius="6" Padding="14">
                <ScrollViewer>
                  <StackPanel Spacing="8">
                    <TextBlock Text="Selected Mod" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ModDetailNameText" Text="Select a mod" FontSize="17"/>
                    <TextBlock x:Name="ModDetailIdText" Opacity="0.7"/>
                    <TextBlock x:Name="ModDetailAuthorText"/>
                    <TextBlock x:Name="ModDetailPlatformText"/>
                    <TextBlock x:Name="ModDetailRatingText"/>
                    <TextBlock x:Name="ModDetailDownloadsText"/>
                    <TextBlock x:Name="ModDetailUpdatedText"/>
                    <TextBlock x:Name="ModDetailFileText" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ModDetailAvailabilityText" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ModDetailDependenciesText" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ModDetailSummaryText" TextWrapping="Wrap" Opacity="0.8"/>
                    <Separator/>
                    <TextBlock x:Name="ModMetadataStatusText" Text="Metadata: not queried" Opacity="0.6"/>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Grid>

            <Border Grid.Row="2" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Launch order:" FontWeight="SemiBold"/>
                <TextBlock x:Name="ModsLaunchPreviewText" FontFamily="Consolas, monospace" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="Browse Mods">
          <Grid Margin="10" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
            <Grid Grid.Row="0" ColumnDefinitions="*,180,150,120,Auto" ColumnSpacing="8">
              <TextBox x:Name="ModBrowseSearchBox" PlaceholderText="Search by mod name, keyword, or author"/>
              <ComboBox x:Name="ModBrowseSortBox" Grid.Column="1" SelectedIndex="0">
                <ComboBoxItem Content="Popularity" Tag="Popularity"/>
                <ComboBoxItem Content="Last Updated" Tag="LastUpdated"/>
                <ComboBoxItem Content="Downloads" Tag="Downloads"/>
                <ComboBoxItem Content="Rating" Tag="Rating"/>
                <ComboBoxItem Content="Released Date" Tag="ReleasedDate"/>
                <ComboBoxItem Content="Name" Tag="Name"/>
                <ComboBoxItem Content="Author" Tag="Author"/>
                <ComboBoxItem Content="File Size" Tag="Size"/>
              </ComboBox>
              <ComboBox x:Name="ModBrowseDirectionBox" Grid.Column="2" SelectedIndex="0">
                <ComboBoxItem Content="Descending" Tag="desc"/>
                <ComboBoxItem Content="Ascending" Tag="asc"/>
              </ComboBox>
              <ComboBox x:Name="ModBrowsePageSizeBox" Grid.Column="3" SelectedIndex="1">
                <ComboBoxItem Content="20 results" Tag="20"/>
                <ComboBoxItem Content="50 results" Tag="50"/>
              </ComboBox>
              <Button Grid.Column="4" Content="Search" Padding="18,6" Click="BrowseModsSearch_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="8">
              <Border BorderBrush="#444" BorderThickness="1" CornerRadius="5" Padding="8">
                <TextBlock x:Name="ModBrowseStatusText" Text="Mod catalogue ready." TextWrapping="Wrap" Opacity="0.7"/>
              </Border>

              <Expander Header="Catalogue Connection">
                <Border BorderBrush="#333" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,4,0,0">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="CurseForge API key" VerticalAlignment="Center"/>
                    <TextBox x:Name="CurseForgeApiKeyBox"
                             Grid.Column="1"
                             PasswordChar="●"
                             Watermark="Optional provider key"/>
                    <Button Grid.Column="2"
                            Content="Save Connection"
                            Click="SaveCurseForgeProvider_Click"/>
                    <Button Grid.Column="3"
                            Content="Open CurseForge"
                            Click="OpenCurseForgeWebsite_Click"/>
                  </Grid>
                </Border>
              </Expander>
            </StackPanel>

            <ListBox x:Name="ModBrowseResultsList" Grid.Row="2" SelectionChanged="ModBrowseResultsList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:AsaModEntry">
                  <Border BorderBrush="#444" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="112,*,Auto" ColumnSpacing="16">
                      <Border Width="104"
                              Height="104"
                              CornerRadius="7"
                              Background="#1D1D1D"
                              BorderBrush="#444"
                              BorderThickness="1"
                              ClipToBounds="True"
                              VerticalAlignment="Center">
                        <Grid>
                          <TextBlock Text="ARK MOD"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     Opacity="0.28"/>
                          <Image Source="{Binding LogoUrl}"
                                 Stretch="UniformToFill"
                                 Width="104"
                                 Height="104"/>
                        </Grid>
                      </Border>

                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <TextBlock Text="{Binding Author}" Opacity="0.72"/>
                          <TextBlock Text="{Binding PrimaryCategory}" Opacity="0.6"/>
                          <TextBlock Text="{Binding Platform}" Opacity="0.6"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" MaxHeight="44" FontSize="11" Opacity="0.65"/>
                      </StackPanel>

                      <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                        <TextBlock Grid.Row="0" Text="Downloads" FontSize="10" Opacity="0.5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Downloads}"/>
                        <TextBlock Grid.Row="1" Text="Rating" FontSize="10" Opacity="0.5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Rating}"/>
                        <TextBlock Grid.Row="2" Text="Updated" FontSize="10" Opacity="0.5"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastUpdated}"/>
                        <TextBlock Grid.Row="3" Text="File bytes" FontSize="10" Opacity="0.5"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MainFileSizeBytes}"/>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBlock x:Name="ModBrowseSelectionText" Text="Select a result to add it to this server profile." VerticalAlignment="Center" Opacity="0.7"/>
              <Button Grid.Column="1" Content="Add Selected to Server" Click="AddBrowseModToServer_Click"/>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem Header="Updates">
          <StackPanel Margin="16" Spacing="10">
            <TextBlock Text="Mod Update Status" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="This view will compare installed profile metadata with the latest CurseForge file metadata. Core server start remains available even when the metadata provider is unavailable." TextWrapping="Wrap" Opacity="0.7"/>
            <Button Content="Refresh Mod Metadata" HorizontalAlignment="Left" Click="RefreshInstalledModMetadata_Click"/>
            <ListBox x:Name="ModUpdatesListBox">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:AsaModEntry">
                  <Border BorderBrush="#444" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="12">
                      <StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding ModId}" FontSize="11" Opacity="0.6"/></StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding LastUpdated}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding MetadataStatus}" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </TabItem>

  </TabControl>

<StackPanel Orientation="Horizontal" Spacing="10">
  <Button Content="Save Profile &amp; Generate Config" Click="SaveProfile_Click"/>
  <Button Content="Delete Profile" Click="DeleteProfile_Click"/>
</StackPanel>
<Separator/><TextBlock Text="Server Controls" FontSize="22" FontWeight="SemiBold"/>
<TextBlock Text="Start launches only the selected profile. Stop requests shutdown and currently falls back to process termination until RCON graceful shutdown is implemented. Restart stops then starts this profile. Force Stop immediately terminates its process tree." Opacity="0.7" TextWrapping="Wrap"/>
<StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Start" Click="StartAsa_Click"/><Button Content="Stop" Click="StopAsa_Click"/><Button Content="Restart" Click="RestartAsa_Click"/><Button Content="Force Stop" Click="ForceStopAsa_Click"/></StackPanel>
<Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8"><TextBlock Text="Status:"/><TextBlock x:Name="ProcessStatusText" Grid.Column="1" Text="Stopped" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="PID:"/><TextBlock x:Name="PidText" Grid.Column="3" Text="-"/><TextBlock Grid.Column="4" Text="Uptime:"/><TextBlock x:Name="UptimeText" Grid.Column="5" Text="-"/></Grid>
<TextBlock Text="Generated launch command" FontWeight="SemiBold" Margin="0,8,0,0"/>
<Border BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="10">
<TextBlock x:Name="LaunchPreviewText" TextWrapping="Wrap" FontFamily="Consolas, monospace" Opacity="0.75"/>
</Border>
</StackPanel>
</StackPanel>
</ScrollViewer>
</TabItem>

<TabItem Header="Console"><Grid Margin="18" RowDefinitions="Auto,*,Auto"><TextBlock Text="JAASM / SteamCMD / ASA Console" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBox x:Name="ConsoleBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, monospace" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/><Button Grid.Row="2" Content="Clear Console" HorizontalAlignment="Right" Margin="0,10,0,0" Click="ClearConsole_Click"/></Grid></TabItem>
</TabControl></Grid></Window>