<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="JAASM.App.MainWindow" Title="Just Another ARK Server Manager" Width="1080" Height="900" MinWidth="860" MinHeight="720">
<Grid RowDefinitions="Auto,*" Margin="28">
<StackPanel Grid.Row="0" Margin="0,0,0,18"><TextBlock Text="JAASM" FontSize="34" FontWeight="Bold"/><TextBlock Text="Just Another ARK Server Manager" Opacity="0.65"/></StackPanel>
<TabControl Grid.Row="1">
<TabItem Header="Server Setup"><ScrollViewer><StackPanel Margin="18" Spacing="14">
<TextBlock Text="SteamCMD Bootstrap" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="PlatformText"/>
<TextBlock Text="Use Existing SteamCMD" FontSize="18" FontWeight="SemiBold"/><TextBox x:Name="SteamCmdPathBox" IsReadOnly="True" PlaceholderText="SteamCMD is not configured"/>
<StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Select Existing Directory" Click="SelectSteamCmd_Click"/><Button Content="Validate" Click="ValidateSteamCmd_Click"/><Button Content="Update SteamCMD" Click="UpdateSteamCmd_Click"/></StackPanel>
<Separator/><TextBlock Text="Install New SteamCMD" FontSize="18" FontWeight="SemiBold"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBox x:Name="SteamCmdInstallDirectoryBox" IsReadOnly="True" PlaceholderText="Select an installation directory"/><Button Grid.Column="1" Content="Browse" Click="BrowseSteamCmdInstallDirectory_Click"/></Grid>
<Button Content="Download &amp; Install SteamCMD" HorizontalAlignment="Left" Click="InstallSteamCmd_Click"/><ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Height="8"/><TextBlock x:Name="StatusText" Text="Ready." TextWrapping="Wrap"/>
<Separator/><TextBlock Text="ARK: Survival Ascended Server Bootstrap" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="ASA Dedicated Server App ID: 2430930" Opacity="0.65"/>
<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBox x:Name="AsaInstallDirectoryBox" IsReadOnly="True" PlaceholderText="Select ASA server installation directory"/><Button Grid.Column="1" Content="Browse" Click="BrowseAsaInstallDirectory_Click"/></Grid>
<StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Install / Update ASA" Click="InstallOrUpdateAsa_Click"/><Button Content="Validate ASA" Click="ValidateAsa_Click"/></StackPanel><TextBlock x:Name="AsaStatusText" Text="ASA server is not configured." TextWrapping="Wrap"/>
<Separator/><TextBlock Text="Optional Web GUI" FontSize="18" FontWeight="SemiBold"/><ToggleSwitch x:Name="WebGuiToggle" Content="Enable Web GUI" IsCheckedChanged="WebGuiToggle_Changed"/><TextBlock Text="Default bind: 127.0.0.1:8484" Opacity="0.65"/>
</StackPanel></ScrollViewer></TabItem>

<TabItem Header="Server Control"><ScrollViewer><StackPanel Margin="18" Spacing="12">
<TextBlock Text="ASA Server Profile" FontSize="22" FontWeight="SemiBold"/>
<Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
<TextBlock Grid.Row="0" Text="Server Name" VerticalAlignment="Center"/><TextBox x:Name="ServerNameBox" Grid.Row="0" Grid.Column="1"/>
<TextBlock Grid.Row="1" Text="Map" VerticalAlignment="Center"/><TextBox x:Name="MapBox" Grid.Row="1" Grid.Column="1"/>
<TextBlock Grid.Row="2" Text="Max Players" VerticalAlignment="Center"/><NumericUpDown x:Name="MaxPlayersBox" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="500"/>
<TextBlock Grid.Row="3" Text="Game Port" VerticalAlignment="Center"/><NumericUpDown x:Name="GamePortBox" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="65535"/>
<TextBlock Grid.Row="4" Text="Query Port" VerticalAlignment="Center"/><NumericUpDown x:Name="QueryPortBox" Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="65535"/>
<TextBlock Grid.Row="5" Text="RCON Port" VerticalAlignment="Center"/><NumericUpDown x:Name="RconPortBox" Grid.Row="5" Grid.Column="1" Minimum="1" Maximum="65535"/>
<TextBlock Grid.Row="6" Text="Server Password" VerticalAlignment="Center"/><TextBox x:Name="ServerPasswordBox" Grid.Row="6" Grid.Column="1" PasswordChar="●"/>
<TextBlock Grid.Row="7" Text="Admin Password" VerticalAlignment="Center"/><TextBox x:Name="AdminPasswordBox" Grid.Row="7" Grid.Column="1" PasswordChar="●"/>
<TextBlock Grid.Row="8" Text="Extra Arguments" VerticalAlignment="Center"/><TextBox x:Name="ExtraArgumentsBox" Grid.Row="8" Grid.Column="1"/>
</Grid>
<Button Content="Save Profile" HorizontalAlignment="Left" Click="SaveProfile_Click"/>
<Separator/><TextBlock Text="Process Control" FontSize="22" FontWeight="SemiBold"/>
<StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Start" Click="StartAsa_Click"/><Button Content="Stop" Click="StopAsa_Click"/><Button Content="Restart" Click="RestartAsa_Click"/><Button Content="Force Stop" Click="ForceStopAsa_Click"/></StackPanel>
<Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8"><TextBlock Text="Status:"/><TextBlock x:Name="ProcessStatusText" Grid.Column="1" Text="Stopped" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="PID:"/><TextBlock x:Name="PidText" Grid.Column="3" Text="-"/><TextBlock Grid.Column="4" Text="Uptime:"/><TextBlock x:Name="UptimeText" Grid.Column="5" Text="-"/></Grid>
<TextBlock x:Name="LaunchPreviewText" TextWrapping="Wrap" Opacity="0.7"/>
</StackPanel></ScrollViewer></TabItem>

<TabItem Header="Console"><Grid Margin="18" RowDefinitions="Auto,*,Auto"><TextBlock Text="JAASM / SteamCMD / ASA Console" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBox x:Name="ConsoleBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, monospace" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/><Button Grid.Row="2" Content="Clear Console" HorizontalAlignment="Right" Margin="0,10,0,0" Click="ClearConsole_Click"/></Grid></TabItem>
</TabControl></Grid></Window>